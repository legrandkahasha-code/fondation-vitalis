# Environnement : 'production' ou 'development'
NODE_ENV=production
PORT=3000

# Base de Données PostgreSQL / Supabase
DATABASE_URL="postgresql://vitalis:MOT_DE_PASSE_SECURISE@localhost:5432/vitalis_center?schema=public"
DIRECT_URL="postgresql://vitalis:MOT_DE_PASSE_SECURISE@localhost:5432/vitalis_center?schema=public"

# Clé secrète JWT (générer une chaîne aléatoire de 64+ caractères en production)
# Commande Linux/Mac : openssl rand -base64 48
JWT_SECRET=changer_ce_secret_par_une_chaine_aleatoire_tres_longue_64_caracteres_min

# Domaines autorisés pour CORS (séparés par des virgules)
CORS_ORIGIN=https://vitaliseup.org,https://www.vitaliseup.org,http://localhost:4200

# Documentation Swagger (recommandé: false en production)
SWAGGER_ENABLED=false
SWAGGER_TOKEN=secret_token_pour_proteger_swagger

# Mode de stockage des fichiers : 'local' ou 's3'
STORAGE_MODE=local

# Configuration S3 / MinIO (si STORAGE_MODE=s3)
# AWS_REGION=eu-west-3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=vitalis-center
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_URL=https://s3.vitalis-center.cd/vitalis-center
